<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/starredPopupRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_starred_popup"
    android:clickable="true"
    android:elevation="12dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="7dp"
    android:paddingEnd="8dp"
    android:paddingBottom="7dp">

    <ImageView
        android:id="@+id/ivStarredIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_star_filled" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STARRED NOTE"
            android:textColor="#FFB800"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStarredValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxWidth="190dp"
            android:maxLines="2"
            android:text="Remember to mention budget"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnDismissStarredPopup"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="4dp"
        android:background="?android:selectableItemBackgroundBorderless"
        android:padding="3dp"
        android:src="@drawable/ic_close"
        android:tint="@color/text_secondary_dark"
        app:tint="@color/text_secondary_dark" />

</LinearLayout>
