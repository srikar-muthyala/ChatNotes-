<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/starredPopupRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_starred_popup"
    android:clickable="true"
    android:elevation="14dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="7dp"
    android:paddingEnd="8dp"
    android:paddingBottom="7dp">

    <!-- Gold Star Icon -->
    <ImageView
        android:id="@+id/ivStarredIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_star_filled" />

    <!-- Center Content Column -->
    <LinearLayout
        android:id="@+id/layoutStarredContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <!-- Header Row with Title and Multi-Star Ticker -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStarredHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STARRED NOTE"
                android:textColor="#FFB800"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStarredTicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge"
                android:paddingStart="5dp"
                android:paddingTop="1dp"
                android:paddingEnd="5dp"
                android:paddingBottom="1dp"
                android:text="1/3"
                android:textColor="#FFFFFF"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Starred Note Text -->
        <TextView
            android:id="@+id/tvStarredValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxWidth="150dp"
            android:maxLines="2"
            android:text="Remember to mention budget"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Next Starred Item Button (visible when multi-star > 1) -->
        <ImageView
            android:id="@+id/btnNextStarred"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="2dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:padding="3dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="#8696A0"
            android:visibility="gone"
            app:tint="#8696A0" />

        <!-- Direct Insert into WhatsApp Message Box -->
        <ImageView
            android:id="@+id/btnInsertStarred"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="2dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:padding="2.5dp"
            android:src="@drawable/ic_insert_chat"
            android:tint="#8696A0"
            app:tint="#8696A0" />

        <!-- One-Tap Copy to Message Bar Button -->
        <ImageView
            android:id="@+id/btnCopyStarred"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="2dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:padding="3.5dp"
            android:src="@drawable/ic_copy"
            android:tint="#8696A0"
            app:tint="#8696A0" />

        <!-- Dismiss Close Button -->
        <ImageView
            android:id="@+id/btnDismissStarredPopup"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:padding="3dp"
            android:src="@drawable/ic_close"
            android:tint="#8696A0"
            app:tint="#8696A0" />
    </LinearLayout>

</LinearLayout>
