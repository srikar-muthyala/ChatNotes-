<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scratchpadContainer"
    android:layout_width="330dp"
    android:layout_height="460dp"
    android:background="@drawable/bg_scratchpad_card_dark"
    android:elevation="18dp"
    android:orientation="vertical">

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/ivHeaderIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_note"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/tvContactName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Contact Name"
            android:textColor="@color/text_primary_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Theme Toggle -->
        <ImageView
            android:id="@+id/btnToggleTheme"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:padding="7dp"
            android:src="@drawable/ic_theme"
            app:tint="@color/text_secondary_dark" />

        <!-- Close Overlay -->
        <ImageView
            android:id="@+id/btnCloseScratchpad"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:padding="7dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary_dark" />
    </LinearLayout>

    <!-- Tab Bar: Checklist vs Notes -->
    <LinearLayout
        android:id="@+id/tabBarLayout"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnTabChecklist"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_pill_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Checklist (0)"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTabNotes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_pill_inactive_dark"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Notes"
            android:textColor="@color/text_secondary_dark"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Content Sections Wrapper (For smooth crossfade animation) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- View A: Checklist View -->
        <LinearLayout
            android:id="@+id/layoutChecklistSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/btnClearAllChecklist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:selectableItemBackground"
                    android:padding="4dp"
                    android:text="Clear All"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChecklist"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <TextView
                android:id="@+id/tvEmptyChecklist"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="No points yet.\nType below to add talking points!"
                android:textColor="@color/text_secondary_dark"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Input Bar -->
            <LinearLayout
                android:id="@+id/inputBarLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <EditText
                    android:id="@+id/etNewChecklistItem"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_pill_inactive_dark"
                    android:hint="Add talking point..."
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/text_primary_dark"
                    android:textColorHint="@color/text_secondary_dark"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnAddChecklistItem"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_add_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Add"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- View B: Freeform Notes View -->
        <LinearLayout
            android:id="@+id/layoutNotesSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etFreeformNotes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="top|start"
                android:hint="Write general notes, addresses, memos, or thoughts about this contact..."
                android:lineSpacingExtra="3dp"
                android:padding="16dp"
                android:textColor="@color/text_primary_dark"
                android:textColorHint="@color/text_secondary_dark"
                android:textSize="13.5sp" />

            <LinearLayout
                android:id="@+id/notesFooterBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tvAutoSaveIndicator"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✓ Saved locally"
                    android:textColor="@color/primary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvNotesCharCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 characters"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
